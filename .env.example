# pg_manage_v2 — .env template
# .env itself is gitignored; this file is the tracked record of what a
# deployment needs. Copy to .env and fill in. Secrets come from their owners
# (superuser password: root-only host secret / rotation script — see CLAUDE.md).
#
# NOTE: the two SCHEDULED scripts (scripts/backup.sh, scripts/
# check-partition-horizon.sh) read NOTHING from this file except RELEASE_SHA
# (grep'd, never sourced). Everything below APP_NAME exists for the dormant
# Azure->local seeding tooling (setup doc STEP 5) and azure_to_azure scripts.
#
# RELEASE_SHA is injected into the DEPLOYED copy by build-release.sh — never
# set it by hand; a dev clone must not have it (runs then log sha=dev-tree).

APP_NAME=pg_manage_v2

# --- Seeding tooling: SOURCE (Azure PostgreSQL being copied FROM) -----------
SRC_HOST=<azure-server>.postgres.database.azure.com
SRC_PORT=5432
SRC_USER=<azure-admin-user>
SRC_PASSWORD=<secret>
SRC_DB=<source-db-name>
SRC_SSLMODE=verify-full
SRC_SSLROOTCERT=db/BaltimoreCyberTrustRoot.crt.pem

# --- Seeding tooling: DESTINATION (local pg_db container) -------------------
# DST_PASSWORD is the LIVE PG SUPERUSER password — this key is why the repo is
# registered with the host rotation script (matches on this value; rewrites
# /opt/apps/pg_manage_v2/.env AND ~/apps/pg_manage_v2/.env). Known wart.
DST_HOST=host.docker.internal
DST_PORT=5432
DST_USER=postgres
DST_PASSWORD=<secret>
DST_DB=<per-server db: dev|staging|prod>
DST_SSLMODE=require
DST_SSLROOTCERT=

# --- Seeding tooling: table lists (see setup_info.txt for the full sets) ----
PUBLIC_TABLES=<space-separated schema.table list>
ALERT_TABLES=<...>
CONFIG_TABLES=<...>
EDU_KDB_TABLES=<...>
UTIL_TABLES=<...>
LOG_TABLES=<...>
MAG_TABLES=<...>
EDU_TABLES=<...>
PHILIPS_LOGCURRENT=<...>
FILTERED_TABLES=<...>
TABLES=<...>
NEW_SCHEMA_PORT=5432
CON_DATA=<...>

# --- Time-constrained copies (3_/4_ scripts) --------------------------------
DAYS_BACK=2
DATE_COL_DEFAULT=capture_datetime

# --- azure_to_azure scripts (Azure PROD -> Azure STAGING copies) ------------
PROD_HOST=<azure-prod-server>.postgres.database.azure.com
PROD_PORT=5432
PROD_DB=<prod-db>
PROD_USER=<user>
PROD_PW=<secret>
STAGING_HOST=<azure-staging-server>.postgres.database.azure.com
STAGING_PORT=5432
STAGING_DB=<staging-db>
STAGING_USER=<user>
STAGING_PW=<secret>
